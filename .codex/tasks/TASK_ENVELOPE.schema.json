{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsgeorref.local/schemas/task-envelope/1.6.0",
  "title": "DSGeorref TaskEnvelope 1.6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "issue_id",
    "sprint_id",
    "epic_id",
    "story_id",
    "role",
    "outcome",
    "references",
    "allow_paths",
    "deny_paths",
    "acceptance_criteria",
    "tests",
    "stop_conditions",
    "acceptance_criterion_ids",
    "governing_adrs",
    "requirement_basis",
    "requirements_review_status",
    "bounded_context",
    "context_map_dependencies",
    "domain_model_impact",
    "ddd_review_status",
    "adr_review_status",
    "adr_baseline",
    "applicable_specifications",
    "specification_review_status",
    "specification_baseline",
    "phase_f_review",
    "sprint_review_status",
    "sprint_review_baseline",
    "phase_g_review",
    "cto_review_status",
    "cto_review_baseline"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4}$"
    },
    "issue_id": {
      "type": "string",
      "pattern": "^ISSUE-[0-9]{4}$"
    },
    "role": {
      "type": "string",
      "enum": [
        "Product Owner",
        "Arquiteto",
        "Tech Lead",
        "Backend",
        "Frontend",
        "IA",
        "Geoprocessamento",
        "QA",
        "DevOps",
        "Security",
        "Reviewer"
      ]
    },
    "outcome": {
      "type": "string",
      "minLength": 10
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "allow_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "deny_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "story_id": {
      "type": "string",
      "pattern": "^STORY-[0-9]{4}$"
    },
    "epic_id": {
      "type": "string",
      "pattern": "^EPIC-[0-9]{3}$"
    },
    "sprint_id": {
      "type": "string",
      "pattern": "^SPRINT-[0-9]{3}$"
    },
    "acceptance_criterion_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AC-ISSUE-[0-9]{4}-[0-9]{2}$"
      },
      "minItems": 1
    },
    "governing_adrs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ADR-[0-9]{3}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requirement_basis": {
      "type": "string",
      "enum": [
        "DIRECT_REQUIREMENT",
        "DERIVED_CONTROL",
        "MIXED"
      ]
    },
    "requirements_review_status": {
      "type": "string",
      "enum": [
        "PASS",
        "BLOCKED"
      ]
    },
    "bounded_context": {
      "type": "string",
      "pattern": "^BC-[0-9]{3}$"
    },
    "context_map_dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^BC-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "domain_model_impact": {
      "type": "string",
      "enum": [
        "NONE",
        "LOCAL_MODEL",
        "PUBLIC_CONTRACT",
        "CROSS_CONTEXT_INTEGRATION"
      ]
    },
    "ddd_review_status": {
      "type": "string",
      "enum": [
        "PASS",
        "BLOCKED"
      ]
    },
    "adr_review_status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "adr_baseline": {
      "const": "SAR-v2.9-PHASE-F"
    },
    "applicable_specifications": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SPEC-00[1-5]$"
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "specification_review_status": {
      "const": "PASS"
    },
    "specification_baseline": {
      "const": "SAR-v2.9-PHASE-F"
    },
    "sprint_review_status": {
      "const": "PASS"
    },
    "sprint_review_baseline": {
      "const": "SAR-v2.9-PHASE-F"
    },
    "phase_f_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "dependencies",
        "files",
        "api",
        "database",
        "frontend",
        "geo",
        "ai",
        "tests",
        "artifacts",
        "acceptance_criteria",
        "review"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "count",
            "items"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "BLOCKED"
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "allow_paths",
            "deny_paths"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "BLOCKED"
              ]
            },
            "allow_paths": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "deny_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applicability",
            "status",
            "contracts",
            "contract_sources"
          ],
          "properties": {
            "applicability": {
              "type": "string",
              "enum": [
                "APPLICABLE",
                "NOT_APPLICABLE"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "BLOCKED"
              ]
            },
            "contracts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "contract_sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applicability",
            "status",
            "authorities",
            "migration_required",
            "rollback_required"
          ],
          "properties": {
            "applicability": {
              "type": "string",
              "enum": [
                "APPLICABLE",
                "NOT_APPLICABLE"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "BLOCKED"
              ]
            },
            "authorities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "migration_required": {
              "type": "boolean"
            },
            "rollback_required": {
              "type": "boolean"
            }
          }
        },
        "frontend": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applicability",
            "status",
            "authorities"
          ],
          "properties": {
            "applicability": {
              "type": "string",
              "enum": [
                "APPLICABLE",
                "NOT_APPLICABLE"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "BLOCKED"
              ]
            },
            "authorities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "geo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applicability",
            "status",
            "authorities"
          ],
          "properties": {
            "applicability": {
              "type": "string",
              "enum": [
                "APPLICABLE",
                "NOT_APPLICABLE"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "BLOCKED"
              ]
            },
            "authorities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "ai": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applicability",
            "status",
            "authorities",
            "protocol_required"
          ],
          "properties": {
            "applicability": {
              "type": "string",
              "enum": [
                "APPLICABLE",
                "NOT_APPLICABLE"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "BLOCKED"
              ]
            },
            "authorities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "protocol_required": {
              "type": "boolean"
            }
          }
        },
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "items"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "BLOCKED"
              ]
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applicability",
            "status",
            "kinds",
            "evidence",
            "contract"
          ],
          "properties": {
            "applicability": {
              "type": "string",
              "enum": [
                "PRODUCT_AND_EVIDENCE",
                "EVIDENCE_ONLY"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "BLOCKED"
              ]
            },
            "kinds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "contract": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "acceptance_criteria": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "count",
            "ids"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "BLOCKED"
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^AC-ISSUE-[0-9]{4}-[0-9]{2}$"
              }
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "required_roles",
            "same_candidate_commit"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "BLOCKED"
              ]
            },
            "required_roles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "same_candidate_commit": {
              "const": true
            }
          }
        }
      }
    },
    "phase_g_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "risk_tier",
        "applicable_controls",
        "non_applicable_controls",
        "required_evidence",
        "production_gate"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "risk_tier": {
          "enum": [
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "applicable_controls": {
          "type": "array",
          "items": {
            "enum": [
              "CTO-001",
              "CTO-002",
              "CTO-003",
              "CTO-004",
              "CTO-005",
              "CTO-006",
              "CTO-007",
              "CTO-008",
              "CTO-009",
              "CTO-010",
              "CTO-011",
              "CTO-012",
              "CTO-013",
              "CTO-014",
              "CTO-015"
            ]
          },
          "minItems": 5,
          "uniqueItems": true
        },
        "non_applicable_controls": {
          "type": "array",
          "items": {
            "enum": [
              "CTO-001",
              "CTO-002",
              "CTO-003",
              "CTO-004",
              "CTO-005",
              "CTO-006",
              "CTO-007",
              "CTO-008",
              "CTO-009",
              "CTO-010",
              "CTO-011",
              "CTO-012",
              "CTO-013",
              "CTO-014",
              "CTO-015"
            ]
          },
          "uniqueItems": true
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "production_gate": {
          "enum": [
            "IMPLEMENTATION_AUTHORIZATION",
            "BENCHMARK_AND_OPERATIONS_GATES",
            "SECURITY_AND_PRIVACY_GATES"
          ]
        }
      }
    },
    "cto_review_status": {
      "const": "PASS"
    },
    "cto_review_baseline": {
      "const": "SAR-v3.0-PHASE-G"
    }
  }
}
