{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsgeorref.local/contracts/edit-cases/edit-case/1.0.0",
  "title": "EditCase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "project_id",
    "subject",
    "base_result_snapshot_id",
    "status",
    "revision",
    "edit_bundle_id",
    "review_state",
    "application_state",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_type",
        "subject_id"
      ],
      "properties": {
        "subject_type": {
          "enum": [
            "IMAGE_RESULT",
            "RELATIVE_COMPONENT",
            "MOSAIC_RESULT"
          ]
        },
        "subject_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "base_result_snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "DRAFT",
        "IN_REVIEW",
        "CHANGES_REQUESTED",
        "APPROVED",
        "APPLYING",
        "APPLIED",
        "VALIDATING",
        "ACCEPTED",
        "REJECTED",
        "ROLLED_BACK",
        "SUPERSEDED",
        "CANCELLED"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "edit_bundle_id": {
      "type": "string",
      "format": "uuid"
    },
    "review_state": {
      "type": "object",
      "required": [
        "required_reviewers",
        "decisions"
      ],
      "properties": {
        "required_reviewers": {
          "type": "integer",
          "minimum": 1
        },
        "decisions": {
          "type": "array",
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://dsgeorref.local/contracts/edit-cases/review-decision/1.0.0",
            "title": "ReviewDecision",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decision_id",
              "case_id",
              "revision",
              "decision",
              "decided_by",
              "decided_at",
              "rationale"
            ],
            "properties": {
              "decision_id": {
                "type": "string",
                "format": "uuid"
              },
              "case_id": {
                "type": "string",
                "format": "uuid"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "decision": {
                "enum": [
                  "APPROVE",
                  "REQUEST_CHANGES",
                  "REJECT",
                  "CANCEL"
                ]
              },
              "decided_by": {
                "type": "string"
              },
              "decided_at": {
                "type": "string",
                "format": "date-time"
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "application_state": {
      "type": "object",
      "required": [
        "attempt_id",
        "result_snapshot_id",
        "validation_status"
      ],
      "properties": {
        "attempt_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "result_snapshot_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "validation_status": {
          "enum": [
            "NOT_STARTED",
            "PENDING",
            "PASS",
            "FAIL"
          ]
        },
        "failure_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "rollback_plan_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
