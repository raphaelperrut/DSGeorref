{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsgeorref.local/contracts/edit-cases/rollback-plan/1.0.0",
  "title": "RollbackPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rollback_plan_id",
    "case_id",
    "from_result_snapshot_id",
    "to_result_snapshot_id",
    "reason",
    "requested_by",
    "requested_at",
    "impact_preview",
    "status"
  ],
  "properties": {
    "rollback_plan_id": {
      "type": "string",
      "format": "uuid"
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "from_result_snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "to_result_snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "requested_by": {
      "type": "string"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "impact_preview": {
      "type": "object",
      "additionalProperties": true
    },
    "status": {
      "enum": [
        "PROPOSED",
        "APPROVED",
        "EXECUTING",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    }
  }
}
