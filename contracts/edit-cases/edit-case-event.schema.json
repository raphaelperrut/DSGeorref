{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsgeorref.local/contracts/edit-cases/edit-case-event/1.0.0",
  "title": "EditCaseEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "case_id",
    "case_revision",
    "occurred_at",
    "actor",
    "payload",
    "event_sha256"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "pattern": "^EDIT_CASE_[A-Z_]+$"
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "case_revision": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "event_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
