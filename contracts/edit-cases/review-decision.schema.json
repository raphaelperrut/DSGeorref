{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsgeorref.local/contracts/edit-cases/review-decision/1.0.0",
  "title": "ReviewDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "case_id",
    "revision",
    "decision",
    "decided_by",
    "decided_at",
    "rationale"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "format": "uuid"
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REQUEST_CHANGES",
        "REJECT",
        "CANCEL"
      ]
    },
    "decided_by": {
      "type": "string"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
