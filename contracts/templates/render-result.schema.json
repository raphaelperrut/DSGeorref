{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsgeorref.local/contracts/templates/render-result/1.0.0",
  "title": "RenderResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "render_id",
    "template_id",
    "template_version",
    "status",
    "output_sha256",
    "output_bytes",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "render_id": {
      "type": "string",
      "format": "uuid"
    },
    "template_id": {
      "type": "string"
    },
    "template_version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "output_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
