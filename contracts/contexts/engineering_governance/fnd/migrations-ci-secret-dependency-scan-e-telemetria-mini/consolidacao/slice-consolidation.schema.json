{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsgeorref.local/contracts/contexts/engineering-governance/migrations-ci-security-observability-slice-consolidation/1.0.0",
  "title": "Migrations CI Security and Observability Slice Consolidation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "consolidation_id",
    "contract_version",
    "owner",
    "status",
    "baseline",
    "slices",
    "coverage",
    "integration",
    "review_gate"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "consolidation_id": { "const": "MIGRATIONS-CI-SECURITY-OBSERVABILITY-SLICE-CONSOLIDATION" },
    "contract_version": { "const": "1.0.0" },
    "owner": { "const": "BC-001" },
    "status": { "const": "FROZEN" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_commit", "sprint_review", "specification"],
      "properties": {
        "candidate_commit": { "$ref": "#/$defs/commit" },
        "sprint_review": { "const": "SAR-v2.9-PHASE-F" },
        "specification": { "const": "SAR-v2.9-PHASE-F" }
      }
    },
    "slices": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/slice" }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "requirement_ids", "duplicates", "unassigned"],
      "properties": {
        "source": { "const": "docs/07-assurance/ISSUE_REQUIREMENTS_REVIEW.csv" },
        "requirement_ids": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requirement" }
        },
        "duplicates": { "type": "array", "maxItems": 0 },
        "unassigned": { "type": "array", "maxItems": 0 }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition",
        "control_namespaces",
        "contract_collisions",
        "redundant_implementations",
        "runtime_materialization"
      ],
      "properties": {
        "composition": { "const": "SIDE_BY_SIDE_PUBLISHED_CONTRACTS" },
        "control_namespaces": {
          "type": "array",
          "prefixItems": [
            { "const": "MIGRATIONS-CI-OBSERVABILITY-FOUNDATION" },
            { "const": "SGVCAL-CONFORMANCE" }
          ],
          "items": false,
          "minItems": 2
        },
        "contract_collisions": { "type": "array", "maxItems": 0 },
        "redundant_implementations": { "type": "array", "maxItems": 0 },
        "runtime_materialization": { "const": "DOWNSTREAM_STORIES_ONLY" }
      }
    },
    "review_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_role",
        "same_candidate_commit",
        "residual_risks_required",
        "self_approval",
        "candidate_state",
        "eligible_dependents",
        "released_dependents"
      ],
      "properties": {
        "authority_role": { "const": "Reviewer" },
        "same_candidate_commit": { "const": true },
        "residual_risks_required": { "const": true },
        "self_approval": { "const": "PROHIBITED" },
        "candidate_state": { "const": "READY_FOR_INDEPENDENT_REVIEW" },
        "eligible_dependents": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/story" }
        },
        "released_dependents": { "type": "array", "maxItems": 0 }
      }
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "story": { "type": "string", "pattern": "^STORY-[0-9]{4}$" },
    "requirement": { "type": "string", "pattern": "^REQ-[A-Z0-9-]+$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "story_id",
        "issue_id",
        "task_id",
        "merge_commit",
        "contract_id",
        "requirements",
        "artifacts"
      ],
      "properties": {
        "story_id": { "$ref": "#/$defs/story" },
        "issue_id": { "type": "string", "pattern": "^ISSUE-[0-9]{4}$" },
        "task_id": { "type": "string", "pattern": "^TASK-[0-9]{4}$" },
        "merge_commit": { "$ref": "#/$defs/commit" },
        "contract_id": { "type": "string", "minLength": 1 },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requirement" }
        },
        "artifacts": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    }
  }
}
