          "$ref": "#/components/parameters/IdempotencyKey"
        }
      ],
      "errors": {
        "bootstrap_already_completed": 409,
        "password_policy_failed": 422,
        "validation_failed": 422,
        "internal_error": 500
      },
      "guards": [
        {
          "fact": "authority_ready",
          "error": "internal_error"
        },
        {
