    "post_auth_bootstrap": {
      "method": "POST",
      "path": "/auth/bootstrap",
      "permission": "instance:bootstrap",
      "success_status": 202,
      "request_schema": "PostAuthBootstrapRequest",
      "response_schema": "PostAuthBootstrapResponse",
      "resource_schema": "BootstrapStatus",
      "idempotency": "required",
      "security": [],
      "parameters": [
