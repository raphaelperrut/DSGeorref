  "policies": {
    "local_account": {
      "authority": "PostgreSQL",
      "password_algorithm": "Argon2id",
      "password_parameters": "approved bounded profile; absent or invalid => DENY",
      "default_password": false,
      "creation": "BootstrapAdmin creates active first administrator atomically; other internal creation requires a registered server-side administrative decision; none of the eight HTTP operations is a general account creation endpoint",
      "deactivation": "inactive denies existing sessions/PATs at every use; locked denies authentication until authoritative unlock; no client activation or reset",
      "lifecycle": "activate/deactivate require administrative decision in versioned policy; missing action/grant denies; lock/unlock are server-owned profile transitions",
      "recovery": "offline kit and audited ceremony per ADR-028; does not reopen bootstrap or bypass policy"
    },
    "bootstrap": {
      "availability": "authoritative available AND no completed bootstrap AND no first administrator committed; no cached or broker-derived availability",
      "atomic_effects": [
        "first administrator active",
        "password hash persisted",
        "server-side session persisted",
        "bootstrap completed forever",
        "idempotency outcome and audit committed"
      ],
      "concurrency": "one authoritative compare-and-set/lock transaction; only one winner; loser rereads completed and returns bootstrap_already_completed; no partially committed administrator/session",
      "repeat": "distinct key or payload after completion => 409 bootstrap_already_completed; exact recorded replay may return original nonsecret BootstrapStatus, creates nothing, revalidates session before cookie use; unavailable replay authority => internal_error",
      "exceptions": "trusted installation capability evaluates instance:bootstrap server-side before any administrator exists; public route is not an unconditional grant; failed transaction stays available; account deletion/recovery never resets completion",
      "audit": "AdminBootstrapped only after commit; denied attempts record operation, decision, state and correlation without password or cookie"
    },
    "session": {
      "storage": "opaque credential, server-side persisted state; cookie dsgeorref_session; no self-contained claims as authorization",
      "validity": "active AND account active AND authoritative expiry later than server time AND current revision; expiry/revocation checked on every use",
      "rotation": "old identifier becomes rotated and unusable in same commit as distinct active replacement and fresh CSRF; no grace or resurrection",
      "logout": "current authenticated owner or explicitly authorized server-side decision; sessionCookie or PAT accepted as published; PAT does not implicitly identify a target session; absent authoritative target => session_not_found",
      "expiration": "server-owned expiry, no client extension; expired/revoked/rotated terminal; new creation gets new identity",
      "replay": "same validated key/payload/principal uses recorded outcome, creates no extra session; replay cannot resurrect or authenticate expired/revoked session",
      "web": "CSRF bound to session plus Origin/Fetch Metadata for applicable cookie mutations; restrictive cookie attributes and CORS/TLS per ADR-031; no PAT downgrade after invalid cookie"
    },
    "pat": {
      "storage": "opaque prefixed bearer; only hash and nonsecret metadata persisted; plaintext delivered once on initial issuance, never in audit/log/retrieval",
      "validity": "active AND account active AND server expiry future AND scopes subset of currently authorized actions/resources; no role/scope escalation",
      "expiration": "requested future expiry must satisfy approved profile; omitted/null uses finite expiry from approved policy, never unlimited default; missing policy => internal_error",
      "replay": "Idempotency-Key prevents duplicate issue; replay after one-time plaintext delivery => conflict; no plaintext persistence or silent reissue",
      "revocation": "owner or registered administrative server decision; authoritative revoke makes all future uses fail, no HTTP revoke endpoint added",
      "scope": "scope names resolve via versioned central policy; unknown/empty scopes deny; bearer is not an OIDC token; no implicit token exchange"
    },
    "oidc": {
      "optional": true,
      "identity_key": [
        "issuer",
        "subject"
      ],
      "linking": "explicit linking bound to authenticated internal account; no email/username match, auto-provision, IdP role grants or implicit local-account authentication",
      "port": "adapter exchanges code using server-owned state transaction, nonce and configured provider; returns validated external identity DTO only; application ACL resolves issuer+subject to account ID and owns authorization",
      "dto_schema": "boundary-evidence.schema.json#/$defs/oidc",
      "config": "explicit enabled provider, HTTPS issuer, clientId, redirect URI; configuration absence/provider outage/invalid result fails callback with published code, never local fallback",
      "callback": "state is browser/transaction-bound, expires and is single-use; nonce, issuer, audience, signature and expiry must pass; successful session commit consumes state; failed callback is failed and cannot authenticate; retry needs new transaction",
      "linked_result": "linked is true only if explicit link is committed in this callback; existing authoritative link produces false; both require existing active Account",
      "provider_tokens": "code, provider access/ID tokens and SDK models do not cross downstream context boundary or enter audit",
      "revocation": "unlink/change audit and invalidate authentication based on old issuer+subject; no automatic relink; failed provider revalidation stays unavailable"
    },
    "authorization": {
      "authority": "BC-002 versioned application policy, server-side on every operation and every credential use",
      "decision_inputs": [
        "principal",
        "action",
        "resource",
        "policyVersion",
        "account state",
        "credential state",
        "scope",
        "membership revision"
      ],
      "roles": [
        "owner",
        "editor",
        "reviewer",
        "viewer"
      ],
      "role_interpretation": "only server policy maps the existing roles; this freeze grants none by role label or IdP claim; absent policy/action/resource/grant => DENY",
      "exceptions": "BootstrapAdmin uses installation capability, CriarSessao uses validated credentials without prior session, callback uses validated one-time OIDC transaction; each still evaluates published required permission",
      "check": "authorization:check guards caller; allowed describes requested action, never replaces enforcement on later operation; unknown action validation_failed, known denied action allowed=false with policyVersion and reasonCode",
      "membership": "project_member:list/create scoped to requested project; target existing user and registered role; MembershipChanged only after commit; no automatic grant to another project",
      "credential_selection": "explicit sessionCookie or personalAccessToken from published security schemes; ambiguous/conflicting credentials deny, no trying another credential after failure"
    },
    "errors": {
      "transport": "only operation-specific published codes/statuses; application/problem+json with Problem schema",
      "unpublished_mapping": "protective guard without a dedicated public code maps to existing listed error (e.g. callback throttled => oidc_exchange_failed, bootstrap throttled => internal_error); never add HTTP errors",
      "precedence": "ordered guards; missing/nonboolean fact, invalid state, unknown operation, missing server decision or unavailable authority => deny; unknown input never becomes success",
      "failure_atomicity": "no success, session, PAT, account activation or OIDC link escapes an unsuccessful commit; denied attempt observation may be committed separately without allowing action"
    },
    "throttling": {
      "requirement": "REQ-AUTH-IMPL-007",
      "owner": "BC-002",
      "authority": "PostgreSQL; no Redis/in-memory/broker/log authority",
      "state": "persist bounded bucket key digest, policyVersion, revision, failure count, window start/end, blockedUntil; state open/limited/locked",
      "quantitative_values": "only approved profile at runtime; fixture timestamps/counters are synthetic, not benchmark or production policy; missing/invalid profile => DENY",
      "decision": "atomic bucket update and eligibility read; limited=>DENY, locked=>DENY; observe both successful and denied attempts; restart must not reset authoritative state",
      "evidence_schema": "boundary-evidence.schema.json#/$defs/throttle",
      "evidence": "operationId, correlationId, server observedAt, before/after snapshots and reason; audit correlated with commit; no password, raw identity/IP, cookie, code or bearer",
      "cardinality": "metric labels restricted to operationId, state and allowed/denied; digest/correlation IDs are audit fields, never metric labels"
    }
  },
