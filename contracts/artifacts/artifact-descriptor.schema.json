{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsgeorref.local/contracts/artifacts/artifact-descriptor/2.0.0",
  "title": "ArtifactDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_kind",
    "logical_name",
    "relative_path",
    "media_type",
    "size_bytes",
    "sha256",
    "role",
    "validation_profile_id",
    "created_at"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "format": "uuid"
    },
    "artifact_kind": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,80}$"
    },
    "logical_name": {
      "type": "string",
      "minLength": 1
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "media_type": {
      "type": "string",
      "minLength": 3
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "role": {
      "enum": [
        "PRIMARY",
        "SUPPORTING",
        "EVIDENCE",
        "PREVIEW",
        "DIAGNOSTIC",
        "MANIFEST"
      ]
    },
    "validation_profile_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "geospatial": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "crs": {
          "type": [
            "string",
            "null"
          ]
        },
        "bbox": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 6
        },
        "shape": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 3
        },
        "resolution": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "nodata": {},
        "pixel_is_area": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "bands": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "lineage_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
