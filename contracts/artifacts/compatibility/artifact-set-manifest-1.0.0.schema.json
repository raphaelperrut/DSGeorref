{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsgeorref.local/contracts/artifact-set-manifest/1.0.0",
  "title": "ArtifactSetManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_set_id",
    "project_id",
    "attempt_id",
    "created_at",
    "inputs",
    "artifacts",
    "lineage",
    "root_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_set_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "logical_name",
          "relative_path",
          "sha256",
          "media_type"
        ],
        "properties": {
          "logical_name": {
            "type": "string"
          },
          "relative_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "media_type": {
            "type": "string"
          }
        }
      }
    },
    "lineage": {
      "type": "object"
    },
    "root_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
