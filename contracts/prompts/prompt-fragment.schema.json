{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsgeorref.local/contracts/prompts/prompt-fragment/1.0.0",
  "title": "PromptFragment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fragment_id",
    "kind",
    "template_format",
    "content",
    "variables",
    "priority"
  ],
  "properties": {
    "fragment_id": {
      "type": "string",
      "pattern": "^PF-[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "kind": {
      "enum": [
        "SYSTEM_POLICY",
        "ROLE",
        "DOMAIN_CONTEXT",
        "TASK",
        "CONSTRAINT",
        "OUTPUT_CONTRACT",
        "EXAMPLE"
      ]
    },
    "template_format": {
      "enum": [
        "LITERAL",
        "MUSTACHE_SAFE"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64000
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value_type",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "value_type": {
            "enum": [
              "STRING",
              "INTEGER",
              "NUMBER",
              "BOOLEAN",
              "OBJECT",
              "ARRAY"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "default": {},
          "sensitive": {
            "type": "boolean",
            "default": false
          },
          "max_length": {
            "type": "integer",
            "minimum": 1
          },
          "allowed_values": {
            "type": "array",
            "items": {}
          }
        }
      },
      "maxItems": 128
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "enabled_when": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "source": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(repo|inline|generated):"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
