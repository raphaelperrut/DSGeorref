{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsgeorref.local/contracts/assurance/delivery-approval-authority/trust-anchor-set/1.0.0",
  "title": "DeliveryApprovalTrustAnchorSet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "anchor_set_id", "anchor_set_version", "trust_scope", "anchors"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "anchor_set_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"},
    "anchor_set_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "trust_scope": {"const": "DSGEOREF-DELIVERY-APPROVAL-AUTHORITY-V1"},
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "algorithm", "public_key", "purpose", "trust_scope", "valid_from", "valid_until", "revoked_at"],
        "properties": {
          "key_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
          "algorithm": {"const": "Ed25519"},
          "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
          "purpose": {"const": "DELIVERY_TRUST_PROFILE_SIGNING"},
          "trust_scope": {"const": "DSGEOREF-DELIVERY-APPROVAL-AUTHORITY-V1"},
          "valid_from": {"type": "string", "format": "date-time"},
          "valid_until": {"type": "string", "format": "date-time"},
          "revoked_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    }
  }
}
