{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsgeorref.local/contracts/assurance/delivery-approval-authority/role-binding/1.0.0",
  "title": "DeliveryApprovalRoleBinding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_id", "binding_version", "trust_scope", "policy", "principal", "accountable_subject", "role", "task_envelope_ids", "valid_from", "valid_until", "revoked_at", "signature"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "binding_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "binding_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "trust_scope": {"const": "DSGEOREF-DELIVERY-APPROVAL-AUTHORITY-V1"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version"],
      "properties": {
        "profile_id": {"type": "string"},
        "profile_version": {"type": "string"}
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "subject"],
      "properties": {
        "issuer": {"type": "string", "format": "uri", "maxLength": 512},
        "subject": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "accountable_subject": {"type": "string", "pattern": "^acct:[a-z0-9][a-z0-9._:@/-]{2,255}$"},
    "role": {"enum": ["Executor", "QA", "Reviewer"]},
    "task_envelope_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^TASK-[0-9]{4}$"}},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "revoked_at": {"type": ["string", "null"], "format": "date-time"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "message_profile", "value"],
      "properties": {
        "key_id": {"type": "string"},
        "algorithm": {"const": "Ed25519"},
        "message_profile": {"const": "DSGEOREF-DELIVERY-APPROVAL-ROLE-BINDING-V1"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    }
  }
}
