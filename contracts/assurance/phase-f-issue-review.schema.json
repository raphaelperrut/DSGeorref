{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsgeorref.local/contracts/assurance/phase-f-issue-review/1.0.0",
  "title": "Phase F Issue Delivery Review",
  "description": "Contrato para a revisão Sprint → Issue → Dependências → Arquivos → API → Banco → Frontend → Geo → IA → Testes → Artefatos → Critérios → Review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "dependencies",
    "files",
    "api",
    "database",
    "frontend",
    "geo",
    "ai",
    "tests",
    "artifacts",
    "acceptance_criteria",
    "review"
  ],
  "properties": {
    "status": {
      "const": "PASS"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "count",
        "items"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "BLOCKED"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "allow_paths",
        "deny_paths"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "BLOCKED"
          ]
        },
        "allow_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "deny_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "status",
        "contracts",
        "contract_sources"
      ],
      "properties": {
        "applicability": {
          "type": "string",
          "enum": [
            "APPLICABLE",
            "NOT_APPLICABLE"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "BLOCKED"
          ]
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contract_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "status",
        "authorities",
        "migration_required",
        "rollback_required"
      ],
      "properties": {
        "applicability": {
          "type": "string",
          "enum": [
            "APPLICABLE",
            "NOT_APPLICABLE"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "BLOCKED"
          ]
        },
        "authorities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "migration_required": {
          "type": "boolean"
        },
        "rollback_required": {
          "type": "boolean"
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "status",
        "authorities"
      ],
      "properties": {
        "applicability": {
          "type": "string",
          "enum": [
            "APPLICABLE",
            "NOT_APPLICABLE"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "BLOCKED"
          ]
        },
        "authorities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "geo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "status",
        "authorities"
      ],
      "properties": {
        "applicability": {
          "type": "string",
          "enum": [
            "APPLICABLE",
            "NOT_APPLICABLE"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "BLOCKED"
          ]
        },
        "authorities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "status",
        "authorities",
        "protocol_required"
      ],
      "properties": {
        "applicability": {
          "type": "string",
          "enum": [
            "APPLICABLE",
            "NOT_APPLICABLE"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "BLOCKED"
          ]
        },
        "authorities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protocol_required": {
          "type": "boolean"
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "items"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "BLOCKED"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "status",
        "kinds",
        "evidence",
        "contract"
      ],
      "properties": {
        "applicability": {
          "type": "string",
          "enum": [
            "PRODUCT_AND_EVIDENCE",
            "EVIDENCE_ONLY"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "BLOCKED"
          ]
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "contract": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "acceptance_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "count",
        "ids"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "BLOCKED"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^AC-ISSUE-[0-9]{4}-[0-9]{2}$"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "required_roles",
        "same_candidate_commit"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "BLOCKED"
          ]
        },
        "required_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "same_candidate_commit": {
          "const": true
        }
      }
    }
  }
}
