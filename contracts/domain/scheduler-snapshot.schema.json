{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsgeorref.local/schemas/scheduler-snapshot.schema/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "title": "SchedulerSnapshot",
  "required": [
    "id",
    "policy_version",
    "work_units",
    "leases"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "policy_version": {
      "type": "string"
    },
    "work_units": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "leases": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
