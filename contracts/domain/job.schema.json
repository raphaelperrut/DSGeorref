{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsgeorref.local/schemas/job.schema/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "title": "Job",
  "required": [
    "id",
    "project_id",
    "state",
    "progress_sequence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "cancelling",
        "succeeded",
        "partially_succeeded",
        "failed",
        "cancelled"
      ]
    },
    "progress_sequence": {
      "type": "integer",
      "minimum": 0
    }
  }
}
