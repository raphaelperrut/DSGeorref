{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsgeorref.local/schemas/backup-set.schema/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "title": "BackupSet",
  "required": [
    "id",
    "watermark",
    "database_digest",
    "artifact_manifest_digest"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "watermark": {
      "type": "string",
      "format": "date-time"
    },
    "database_digest": {
      "type": "string"
    },
    "artifact_manifest_digest": {
      "type": "string"
    }
  }
}
