{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsgeorref.local/schemas/provider-capability.schema/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "title": "ProviderCapability",
  "required": [
    "provider_id",
    "capability",
    "availability",
    "license_policy"
  ],
  "properties": {
    "provider_id": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "availability": {
      "enum": [
        "available",
        "degraded",
        "offline",
        "blocked"
      ]
    },
    "license_policy": {
      "enum": [
        "allowed",
        "review_required",
        "blocked"
      ]
    }
  }
}
