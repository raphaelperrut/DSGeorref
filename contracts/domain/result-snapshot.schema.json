{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsgeorref.local/contracts/result-snapshot/1.1.0",
  "type": "object",
  "additionalProperties": false,
  "title": "ResultSnapshot",
  "required": [
    "id",
    "project_id",
    "created_at",
    "entries"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "artifact_set_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "edit_case_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "prompt_execution_record_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  }
}
