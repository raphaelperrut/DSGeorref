{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsgeorref.local/schemas/attempt.schema/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "title": "Attempt",
  "required": [
    "id",
    "job_id",
    "plan_digest",
    "state"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "plan_digest": {
      "type": "string"
    },
    "state": {
      "enum": [
        "planned",
        "running",
        "reviewable",
        "accepted",
        "rejected",
        "failed",
        "cancelled"
      ]
    }
  }
}
