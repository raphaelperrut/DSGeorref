{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsgeorref.local/schemas/operational-cost-assessment/1.0.0",
  "title": "Operational Cost Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "currency",
    "deployment_class",
    "quote_date",
    "monthly_budget_brl",
    "monthly_tco_brl",
    "unit_costs",
    "evidence"
  ],
  "properties": {
    "assessment_id": {
      "type": "string",
      "pattern": "^COST-[0-9]{4}-[0-9]{2}$"
    },
    "currency": {
      "const": "BRL"
    },
    "deployment_class": {
      "type": "string",
      "minLength": 2
    },
    "quote_date": {
      "type": "string",
      "format": "date"
    },
    "monthly_budget_brl": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "monthly_tco_brl": {
      "type": "number",
      "minimum": 0
    },
    "unit_costs": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}
